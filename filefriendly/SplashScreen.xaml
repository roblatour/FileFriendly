<Window x:Class="SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FileFriendly" Height="130" Width="300" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual" Topmost="True" AllowsTransparency="True" Background="Transparent" Icon="/filefriendly;component/Resources/fflogogif.gif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/BrushResources.xaml" />
                <ResourceDictionary Source="Resources/ControlResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource WindowsBackgroundBrush}" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="FileFriendly" FontFamily="Vladimir Script" FontSize="24" Foreground="Brown" Opacity="0.7" HorizontalAlignment="Center" />
                <TextBlock Name="tbVersion" FontFamily="Vladimir Script" FontSize="24" Foreground="Brown" Opacity="0.7" HorizontalAlignment="Center" />
                <TextBlock Text="Copyright © 2026 Rob Latour" FontFamily="Vladimir Script" FontSize="20" Foreground="Brown" Opacity="0.7" HorizontalAlignment="Center" />
            </StackPanel>
            <Border BorderBrush="Brown" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" Height="122" VerticalAlignment="Center" Width="290"/>
        </Grid>
    </Border>
</Window>
